<UserControl x:Class="PizzaHeroClicker.Views.ClickerTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:PizzaHeroClicker.Models">
  <UserControl.Resources>
    <Style x:Key="Row" TargetType="StackPanel">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="Unit" TargetType="TextBlock" BasedOn="{StaticResource InlineLabel}">
      <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
      <Setter Property="Margin" Value="8,0,14,0" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="0,0,4,0">

      <!-- Interval -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="INTERVAL BETWEEN ACTIONS" />
          <StackPanel Orientation="Horizontal" IsEnabled="{Binding Profile.RandomInterval, Converter={StaticResource InverseBool}}">
            <StackPanel Margin="0,0,10,0">
              <TextBlock Style="{StaticResource FieldLabel}" Text="Hours" />
              <TextBox Style="{StaticResource NumBox}" Text="{Binding IntervalHours, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
              <TextBlock Style="{StaticResource FieldLabel}" Text="Minutes" />
              <TextBox Style="{StaticResource NumBox}" Text="{Binding IntervalMinutes, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
              <TextBlock Style="{StaticResource FieldLabel}" Text="Seconds" />
              <TextBox Style="{StaticResource NumBox}" Text="{Binding IntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Margin="0,0,14,0">
              <TextBlock Style="{StaticResource FieldLabel}" Text="Milliseconds" />
              <TextBox Style="{StaticResource NumBox}" Text="{Binding IntervalMillis, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Bottom" Margin="0,0,0,7" Text="{Binding IntervalSummary}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <CheckBox Content="Random interval between" IsChecked="{Binding Profile.RandomInterval}" Margin="0,0,10,0" />
            <TextBox Style="{StaticResource NumBox}" Text="{Binding Profile.IntervalMinMs, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding Profile.RandomInterval}" />
            <TextBlock Style="{StaticResource Unit}" Text="and" Margin="8,0,8,0" />
            <TextBox Style="{StaticResource NumBox}" Text="{Binding Profile.IntervalMaxMs, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding Profile.RandomInterval}" />
            <TextBlock Style="{StaticResource Unit}" Text="ms" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Click behaviour -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="CLICKING" />
          <StackPanel Style="{StaticResource Row}">
            <TextBlock Style="{StaticResource InlineLabel}" Text="Plain click uses the" />
            <ComboBox ItemsSource="{x:Static models:EnumValues.ClickButtons}" SelectedItem="{Binding Profile.DefaultButton}" MinWidth="96" />
            <TextBlock Style="{StaticResource Unit}" Text="button," Margin="8,0,8,0" />
            <ComboBox ItemsSource="{x:Static models:EnumValues.ClickKinds}" SelectedItem="{Binding Profile.DefaultKind}" MinWidth="96" />
            <TextBlock Style="{StaticResource Unit}" Text="click" />
          </StackPanel>
          <TextBlock Style="{StaticResource Hint}" Margin="0,-2,0,10"
                     Text="Plain clicking happens at the cursor whenever the Actions list is empty." />
          <StackPanel Style="{StaticResource Row}" Margin="0">
            <TextBlock Style="{StaticResource InlineLabel}" Text="Position jitter ±" />
            <TextBox Style="{StaticResource NumBox}" Width="56" Text="{Binding Profile.JitterPx, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource Unit}" Text="px" />
            <TextBlock Style="{StaticResource InlineLabel}" Text="Glide to each target over" />
            <TextBox Style="{StaticResource NumBox}" Width="64" Text="{Binding Profile.SmoothMoveMs, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource Unit}" Text="ms  (0 = jump)" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Sequence -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="SEQUENCE" />
          <StackPanel Style="{StaticResource Row}">
            <TextBlock Style="{StaticResource InlineLabel}" Text="Run actions in" />
            <ComboBox ItemsSource="{x:Static models:EnumValues.RunOrders}" SelectedItem="{Binding Profile.Order}" />
            <TextBlock Style="{StaticResource Unit}" Text="order" />
            <TextBlock Style="{StaticResource InlineLabel}" Text="Speed ×" />
            <TextBox Style="{StaticResource NumBox}" Width="56" Text="{Binding Profile.SpeedMultiplier}"
                     ToolTip="Scales every interval and duration. 2 = twice as fast, 0.5 = half speed." />
          </StackPanel>
          <StackPanel Style="{StaticResource Row}">
            <TextBlock Style="{StaticResource InlineLabel}" Text="Countdown before starting" />
            <TextBox Style="{StaticResource NumBox}" Text="{Binding Profile.StartDelayMs, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource Unit}" Text="ms" />
          </StackPanel>
          <StackPanel Style="{StaticResource Row}" Margin="0">
            <CheckBox Content="Burst mode: do" IsChecked="{Binding Profile.Burst.Enabled}" Margin="0,0,10,0" />
            <TextBox Style="{StaticResource NumBox}" Width="56" Text="{Binding Profile.Burst.Count, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding Profile.Burst.Enabled}" />
            <TextBlock Style="{StaticResource Unit}" Text="actions, then pause" Margin="8,0,8,0" />
            <TextBox Style="{StaticResource NumBox}" Text="{Binding Profile.Burst.PauseMs, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding Profile.Burst.Enabled}" />
            <TextBlock Style="{StaticResource Unit}" Text="ms, and repeat" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Repeat / auto-stop -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="WHEN TO STOP" />
          <StackPanel Style="{StaticResource Row}" Margin="0">
            <ComboBox ItemsSource="{x:Static models:EnumValues.RepeatModes}" SelectedItem="{Binding Profile.Repeat.Mode}" MinWidth="120" />

            <StackPanel Orientation="Horizontal" Margin="12,0,0,0"
                        Visibility="{Binding Profile.Repeat.Mode, Converter={StaticResource MatchToVis}, ConverterParameter=Infinite}">
              <TextBlock Style="{StaticResource Unit}" Margin="0" Text="Keeps going until you stop it." />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="12,0,0,0"
                        Visibility="{Binding Profile.Repeat.Mode, Converter={StaticResource MatchToVis}, ConverterParameter=Count}">
              <TextBlock Style="{StaticResource InlineLabel}" Text="Stop after" />
              <TextBox Style="{StaticResource NumBox}" Width="90" Text="{Binding Profile.Repeat.Count, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Style="{StaticResource Unit}" Text="actions (clicks, in plain mode)" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="12,0,0,0"
                        Visibility="{Binding Profile.Repeat.Mode, Converter={StaticResource MatchToVis}, ConverterParameter=Loops}">
              <TextBlock Style="{StaticResource InlineLabel}" Text="Stop after" />
              <TextBox Style="{StaticResource NumBox}" Width="90" Text="{Binding Profile.Repeat.Count, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Style="{StaticResource Unit}" Text="passes through the action list" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="12,0,0,0"
                        Visibility="{Binding Profile.Repeat.Mode, Converter={StaticResource MatchToVis}, ConverterParameter=Duration}">
              <TextBlock Style="{StaticResource InlineLabel}" Text="Stop after" />
              <TextBox Style="{StaticResource NumBox}" Width="90" Text="{Binding Profile.Repeat.DurationSeconds}" />
              <TextBlock Style="{StaticResource Unit}" Text="seconds of running" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="12,0,0,0"
                        Visibility="{Binding Profile.Repeat.Mode, Converter={StaticResource MatchToVis}, ConverterParameter=UntilTime}">
              <TextBlock Style="{StaticResource InlineLabel}" Text="Stop at clock time" />
              <TextBox Width="96" FontFamily="{StaticResource MonoFont}" TextAlignment="Center"
                       Text="{Binding Profile.Repeat.UntilTime, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Style="{StaticResource Unit}" Text="24-hour HH:mm or HH:mm:ss" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
