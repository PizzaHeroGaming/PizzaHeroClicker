<UserControl x:Class="PizzaHeroClicker.Views.ActionsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <WrapPanel Grid.Row="0" Margin="0,0,0,4">
      <WrapPanel.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource ChunkyButton}">
          <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
      </WrapPanel.Resources>
      <Button x:Name="AddButton" Content="+ ADD ▾" Style="{StaticResource PrimaryButton}" Margin="0,0,6,6" Click="OnAddClick">
        <Button.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Click" Command="{Binding AddActionCommand}" CommandParameter="click" />
            <MenuItem Header="Key press / combo / sequence" Command="{Binding AddActionCommand}" CommandParameter="key" />
            <MenuItem Header="Wait" Command="{Binding AddActionCommand}" CommandParameter="wait" />
            <MenuItem Header="Scroll" Command="{Binding AddActionCommand}" CommandParameter="scroll" />
            <MenuItem Header="Drag" Command="{Binding AddActionCommand}" CommandParameter="drag" />
            <MenuItem Header="Move cursor" Command="{Binding AddActionCommand}" CommandParameter="move" />
            <MenuItem Header="Pixel wait (wait for a colour)" Command="{Binding AddActionCommand}" CommandParameter="pixelWait" />
            <MenuItem Header="Pixel click (click when a colour appears)" Command="{Binding AddActionCommand}" CommandParameter="pixelClick" />
            <MenuItem Header="Area watch (click things that appear in an area, by colour)" Command="{Binding AddActionCommand}" CommandParameter="areaWatch" />
          </ContextMenu>
        </Button.ContextMenu>
      </Button>
      <Button Content="EDIT" Command="{Binding EditActionCommand}" />
      <Button Content="DUPLICATE" Command="{Binding DuplicateActionCommand}" />
      <Button Content="DELETE" Command="{Binding DeleteActionCommand}" />
      <Button Content="▲" Command="{Binding MoveActionUpCommand}" ToolTip="Move up" />
      <Button Content="▼" Command="{Binding MoveActionDownCommand}" ToolTip="Move down" />
      <Button Content="{Binding CaptureButtonText}" Command="{Binding CaptureByClickCommand}"
              ToolTip="Click a spot on screen to add it as a click action. The capture hotkey adds the cursor position without clicking." />
      <Button Content="CLEAR" Command="{Binding ClearActionsCommand}" />
    </WrapPanel>

    <ListBox x:Name="List" Grid.Row="1" ItemsSource="{Binding Profile.Actions}" SelectedItem="{Binding SelectedAction}"
             AllowDrop="True"
             PreviewMouseLeftButtonDown="OnListMouseDown" PreviewMouseMove="OnListMouseMove"
             DragOver="OnListDragOver" Drop="OnListDrop" MouseDoubleClick="OnListDoubleClick" KeyDown="OnListKeyDown">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="34" />
              <ColumnDefinition Width="30" />
              <ColumnDefinition Width="92" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Row number = the action's real position in the list. (WPF's AlternationIndex is not
                 used: it is not renumbered correctly when a row is moved.) The third binding only
                 exists to make the number refresh whenever the list changes. -->
            <TextBlock Grid.Column="0" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource CheeseBrush}"
                       VerticalAlignment="Center">
              <TextBlock.Text>
                <MultiBinding Converter="{StaticResource ItemNumber}">
                  <Binding />
                  <Binding Path="DataContext.Profile.Actions" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                  <Binding Path="DataContext.ActionListVersion" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
            <CheckBox Grid.Column="1" IsChecked="{Binding Enabled}" Click="OnEnabledClick" ToolTip="Enabled" />
            <Border Grid.Column="2" Background="{StaticResource TomatoDarkBrush}" CornerRadius="6" Padding="6,1"
                    HorizontalAlignment="Left" VerticalAlignment="Center">
              <TextBlock Text="{Binding TypeName}" FontFamily="{StaticResource HeadFont}" FontWeight="SemiBold" FontSize="12" />
            </Border>
            <StackPanel Grid.Column="3" VerticalAlignment="Center">
              <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Label}" Foreground="{StaticResource DimBrush}" FontSize="11"
                         TextTrimming="CharacterEllipsis" Visibility="{Binding Label, Converter={StaticResource TextToVis}}" />
            </StackPanel>
            <TextBlock Grid.Column="4" Text="{Binding IntervalText}" Foreground="{StaticResource DimBrush}"
                       FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" Margin="10,0,2,0" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Record and playback -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12,10">
      <StackPanel>
        <WrapPanel>
          <Button Command="{Binding ToggleRecordingCommand}" Content="{Binding RecordButtonText}" Margin="0,0,14,6">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource ChunkyButton}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsRecording}" Value="True">
                    <Setter Property="Background" Value="{StaticResource TomatoBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource TomatoDarkBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <CheckBox Content="Record mouse movement" IsChecked="{Binding Settings.RecordMouseMoves}" Margin="0,0,16,6"
                    IsEnabled="{Binding IsRecording, Converter={StaticResource InverseBool}}"
                    ToolTip="Off: only clicks, drags, scrolling and keys are recorded." />
          <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
            <CheckBox Content="Trim pauses longer than" IsChecked="{Binding Settings.TrimDelays}" Margin="0,0,8,0" />
            <TextBox Style="{StaticResource NumBox}" Width="64" Text="{Binding Settings.MaxDelayMs, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding Settings.TrimDelays}" />
            <TextBlock Style="{StaticResource InlineLabel}" Text="ms" Margin="6,0,0,0" Foreground="{StaticResource DimBrush}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Style="{StaticResource InlineLabel}" Text="Playback speed ×" />
            <TextBox Style="{StaticResource NumBox}" Width="52" Text="{Binding Profile.SpeedMultiplier}"
                     ToolTip="Scales every delay and duration. 2 = twice as fast." />
          </StackPanel>
        </WrapPanel>
        <TextBlock Text="{Binding RecordStatus}" Foreground="{StaticResource TomatoBrush}" FontWeight="SemiBold"
                   Visibility="{Binding RecordStatus, Converter={StaticResource TextToVis}}" />
      </StackPanel>
    </Border>

    <TextBlock Grid.Row="3" Style="{StaticResource Hint}" Margin="2,8,0,6"
               Text="Drag rows to reorder, double-click to edit. An empty list means plain clicking at the cursor. Recording turns what you do into actions here, with the real timing as each action's delay. Positions are in screen pixels; negative values are monitors left of or above the main one." />
  </Grid>
</UserControl>
